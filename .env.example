# Copier en .env et adapter si besoin
OPTI_HOST=0.0.0.0
OPTI_PORT=8100
OLLAMA_URL=http://127.0.0.1:11434
OPTI_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
OPTI_MODEL_LABEL=Opti · Qwen 3
# Durée des sessions (jours) et cookie sécurisé (true une fois en HTTPS)
OPTI_SESSION_DAYS=7
OPTI_COOKIE_SECURE=false
