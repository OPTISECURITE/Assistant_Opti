# Copier en .env et adapter si besoin
OPTI_HOST=0.0.0.0
OPTI_PORT=8100
OLLAMA_URL=http://127.0.0.1:11434
OPTI_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
OPTI_MODEL_LABEL=Opti · Qwen 3
# Cookie de session sécurisé (true une fois en HTTPS) ; les durées de session se règlent dans l'Administration
OPTI_COOKIE_SECURE=false
# Fichiers joints et analyse de données
OPTI_MAX_UPLOAD_MB=25
OPTI_SANDBOX_MODE=docker
OPTI_SANDBOX_IMAGE=opti-sandbox:2
OPTI_SANDBOX_TIMEOUT=60
OPTI_SANDBOX_MEMORY=2g
# Recherche web
OPTI_SEARXNG_URL=http://127.0.0.1:8888
# Lecture des PDF (pages lues au maximum, durée maximale en secondes)
OPTI_MAX_PDF_PAGES=300
OPTI_PDF_TIMEOUT=300
# Lecture complète des documents longs (caractères donnés au modèle, sections lues au maximum)
OPTI_DOC_FULL_BUDGET=28000
OPTI_HISTORY_FULL_BUDGET=6000
OPTI_MAX_SECTIONS=120
